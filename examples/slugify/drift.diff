+++ b/src/memo.ts
@@ -0,0 +1,8 @@
+const memo = new Map<string, string>();
+
+export function memoize(fn: (s: string) => string) {
+    return (s: string) => {
+        if (!memo.has(s)) memo.set(s, fn(s));
+        return memo.get(s)!;
+    };
+}
